{
  "name": "nextjs-dev-browser",
  "version": "1.2.0",
  "description": "Ephemeral, localhost-only Playwright browser that auto-opens when `next dev` starts and wipes cache/cookies/storage on close — without touching your everyday browser profile.",
  "license": "MIT",
  "main": "lib/localhost-browser.js",
  "types": "lib/localhost-browser.d.ts",
  "bin": {
    "dev-browser": "bin/cli.js"
  },
  "files": [
    "bin",
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test"
  },
  "keywords": [
    "nextjs",
    "next.js",
    "playwright",
    "dev-server",
    "browser",
    "localhost",
    "developer-tools"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "playwright": "^1.47.0"
  },
  "peerDependencies": {
    "next": ">=13"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/k-s-pavan-kumar/nextjs-dev-browser.git"
  },
  "bugs": {
    "url": "https://github.com/k-s-pavan-kumar/nextjs-dev-browser/issues"
  },
  "homepage": "https://github.com/k-s-pavan-kumar/nextjs-dev-browser#readme",
  "author": "Your Name <you@example.com>",
  "publishConfig": {
    "access": "public"
  }
}
